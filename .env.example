# Copy this file to .env.local (for your computer) or add the same two values in
# Vercel → Project → Settings → Environment Variables.
#
# Where to find them: Supabase dashboard → Project Settings → API
#   - Project URL          → NEXT_PUBLIC_SUPABASE_URL
#   - anon / public key    → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# NEVER put the service_role key here or anywhere in this app. The app does not need it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
